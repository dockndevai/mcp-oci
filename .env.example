# --- Connection -------------------------------------------------------------
# Auth strategy. Set OCI_INSTANCE_PRINCIPAL=true to use instance principals
# (when running on an OCI compute instance); otherwise the OCI config file is used.
OCI_INSTANCE_PRINCIPAL=false
# Path to the OCI config file. Empty = ~/.oci/config.
OCI_CONFIG_FILE=
# Profile within the config file. Empty = DEFAULT.
OCI_PROFILE=DEFAULT
# Override the region from the profile (must pass OCI_REGION_ALLOWLIST if set).
OCI_REGION=

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. All shipped tools are read; the
# higher tiers are reserved for future provisioning. Start with read-only.
OCI_MODE=read-only
# Comma-separated compartment allowlist (OCIDs or names). Empty = all.
OCI_COMPARTMENT_ALLOWLIST=
# Comma-separated region allowlist. Empty = the configured region only.
OCI_REGION_ALLOWLIST=
# Reserved: running `terraform apply` through the server (not yet shipped).
OCI_ALLOW_APPLY=false
# Validate + log provisioning intent without executing it.
OCI_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
OCI_AUDIT_LOG=true
