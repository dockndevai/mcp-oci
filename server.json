{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-oci",
  "description": "Oracle Cloud discovery + Terraform generation for AI agents — read-only, secret-safe.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-oci",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-oci",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OCI_PROFILE",
          "description": "Profile within ~/.oci/config (default DEFAULT).",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "OCI_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
